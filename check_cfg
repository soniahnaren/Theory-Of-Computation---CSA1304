#include <stdio.h>
#include <string.h>

int main()
{
    char str[100];
    int i,n;

    printf("Enter a string:");
    scanf("%s",str);

    n=strlen(str);

    if(n%2!=0)
    {
        printf("String does not belong to the language");
        return 0;
    }

    for(i=0;i<n/2;i++)
    {
        if(str[i]!='0'||str[n-i-1]!='1')
        {
            printf("String does not belong to the language");
            return 0;
        }
    }

    printf("String belongs to the language");

    return 0;
}
