#include <stdio.h>
#include <string.h>

int main()
{
    char str[100];
    int i,n;

    printf("Enter a string:");
    scanf("%s",str);

    n=strlen(str);

    for(i=0;i<=n-3;i++)
    {
        if(str[i]=='1'&&str[i+1]=='0'&&str[i+2]=='1')
        {
            printf("String belongs to the language");
            return 0;
        }
    }

    printf("String does not belong to the language");

    return 0;
}
